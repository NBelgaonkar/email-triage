# --- Required ---
MY_EMAIL=you@gmail.com
ANTHROPIC_API_KEY=sk-ant-...

# Gmail token: either a file path (local) or the base64 value from
# `python scripts/authorize.py --print-env` (hosted)
GMAIL_TOKEN_PATH=token.json
# GMAIL_TOKEN_JSON=

# Texting. Google Fi: 10digitnumber@msg.fi.google.com
#          US Cellular: 10digitnumber@email.uscc.net
NOTIFIER=gateway
SMS_GATEWAY_ADDRESS=5555550123@msg.fi.google.com
# NOTIFIER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15555550100
# TWILIO_TO=+15555550123

# --- Behaviour ---
# draft | send
REPLY_MODE=draft
# true = decide and log only, change nothing
DRY_RUN=false
ANTHROPIC_MODEL=claude-sonnet-5-5
MIN_REPLY_CONFIDENCE=0.8
POLL_SECONDS=60
LOOKBACK_HOURS=24
MAX_TEXTS_PER_HOUR=10
STRICT_KEYWORDS_ON_BULK=false

# Comma separated. Full address or domain. Only honored when the sender passes SPF/DKIM.
VIP_SENDERS=
IGNORE_SENDERS=

STATE_DB=data/state.db
PROFILE_PATH=profile.md
# set to expose /health for hosts that need a port
# PORT=8080
